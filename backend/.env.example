# Server
PORT=3000
BASE_URL=http://localhost:3000
JWT_SECRET=replace_with_64_char_random_hex
# Set to production on the live server (disables demo checkout)
NODE_ENV=production
# Only set when running behind a reverse proxy (nginx, Cloudflare, cPanel Node app). 1 = trust one proxy hop.
# Leave empty if the Node server is reached directly, otherwise visitors can spoof their IP.
TRUST_PROXY=
# Time zone for "today", arrival windows and reminders
BUSINESS_TZ=America/New_York
# Minimum minutes between now and a bookable arrival window
BOOKING_LEAD_MINUTES=60
# Fake "demo" checkout is only allowed on http://localhost unless this is true. Never enable on the live site.
ALLOW_DEMO_CHECKOUT=false

# Stripe (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email service: resend | zoho | smtp. Change this one line to switch; restart the server after.
#   resend → set RESEND_API_KEY (https://resend.com/api-keys). Verify boviccleaning.com in Resend first,
#            and FROM_EMAIL must be on that domain.
#   zoho   → set SMTP_USER to your Zoho mailbox and SMTP_PASS to a Zoho *app password*.
#            Host defaults to smtppro.zoho.com; set SMTP_HOST=smtp.zoho.com (free plan) or smtp.zoho.eu if needed.
#   smtp   → any other SMTP server using the SMTP_* settings below.
# With nothing set up, emails are only written to the log (nothing is sent).
EMAIL_PROVIDER=
RESEND_API_KEY=
# Optional: where customer replies go (defaults to FROM_EMAIL)
REPLY_TO_EMAIL=

# SMTP Settings (used by zoho and smtp)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=booking@boviccleaning.com
SMTP_PASS=
FROM_NAME=Bovic Premier Cleaning & Painting Solutions LLC
FROM_EMAIL=booking@boviccleaning.com
ADMIN_ALERT_EMAIL=booking@boviccleaning.com
